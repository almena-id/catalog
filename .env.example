# Almena Catalog web configuration. `task init` copies this file to .env,
# which Next.js, Docker Compose and Task all read.

# Port published on the host by Docker Compose (the portal listens on 3000 inside).
CATALOG_WEB_PORT=3100

# Public origin of the portal (canonical URL, Open Graph and other metadata).
NEXT_PUBLIC_CATALOG_WEB_URL=https://catalog.almena.id

# The API as the Next.js server reaches it (server components, route
# handlers), read at runtime. Against a local API (../api, `task dev`):
# http://localhost:8000
CATALOG_API_URL=https://api.almena.id

# The registry portal, where an offer is applied for until the application
# flow moves here. NEXT_PUBLIC_* values are inlined into the bundle when
# building: rebuild (`task up`) after changing it.
NEXT_PUBLIC_REGISTRY_WEB_URL=https://registry.almena.id
